    {
      "name": "Auth",
      "item": [
        {
          "name": "Register Organization (signup tenant)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/register-organization",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "register-organization"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"org_name\": \"Acme Corp\",\n  \"org_slug\": \"acme-corp\",\n  \"admin_fullname\": \"Admin Acme\",\n  \"admin_email\": \"admin@acme.com\",\n  \"admin_password\": \"Password123!\"\n}"
            },
            "description": "Self-service signup: bikin Organization + user Admin pertamanya sekaligus. access_token & organization_id otomatis kesimpen."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if(res.refresh_token)pm.environment.set('refresh_token',res.refresh_token);",
                  "if (res.access_token) pm.environment.set('access_token', res.access_token);",
                  "if (res.organization && res.organization.id) pm.environment.set('organization_id', res.organization.id);",
                  "if (res.user && res.user.id) pm.environment.set('user_id', res.user.id);",
                  "pm.test('status 2xx', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Login",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
