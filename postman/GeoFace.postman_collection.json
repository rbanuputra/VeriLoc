    {
      "name": "Onboarding (Upload Kontrak)",
      "description": "Flow: upload kontrak (PDF/gambar) -> OCR+parse draft -> HRD review -> confirm -> buat akun+kontrak. Admin/HRD.",
      "item": [
        {
          "name": "Upload Contract (scan)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/onboarding/contracts/upload",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "onboarding",
                "contracts",
                "upload"
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": null
                },
                {
                  "key": "fullname",
                  "value": "Siti Karyawan",
                  "type": "text"
                },
                {
                  "key": "email",
                  "value": "siti@acme.com",
                  "type": "text"
                },
                {
                  "key": "role_id",
                  "value": "{{role_id}}",
                  "type": "text"
                }
              ]
            },
            "description": "Upload file kontrak + info dasar karyawan. Balikin draft hasil scan (extracted_data). document_id auto-save."
