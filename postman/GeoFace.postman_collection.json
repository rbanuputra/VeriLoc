            },
            "description": "Login -> access_token (berisi organization_id) otomatis kesimpen. Untuk SuperAdmin platform pakai admin@geoface.com (hasil seeder)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if(res.refresh_token)pm.environment.set('refresh_token',res.refresh_token);",
                  "if (res.access_token) pm.environment.set('access_token', res.access_token);",
                  "pm.test('dapat token', () => pm.expect(res.access_token).to.be.a('string'));"
                ]
              }
            }
          ],
          "response": []
        },
