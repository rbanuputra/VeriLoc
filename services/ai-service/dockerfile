# === AI Service (FastAPI + DeepFace) ===
# Gunakan python slim agar image tidak terlalu besar
FROM python:3.10-slim

# Cache model DeepFace disimpan di sini (bukan di /root, karena kita pakai non-root user)
ENV DEEPFACE_HOME=/app/.deepface
ENV PYTHONUNBUFFERED=1

# Install dependensi sistem yang dibutuhkan OpenCV.
# Catatan: di Debian 13 (trixie) paket lama 'libgl1-mesa-glx' sudah diganti 'libgl1'.
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 \
    libglib2.0-0 \
    tesseract-ocr \
    tesseract-ocr-ind \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install dependencies dulu (manfaatkan layer cache)
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy source code
COPY . .

# Best practice: jangan jalan sebagai root.
# chown /app biar user non-root bisa nulis cache model DeepFace (/app/.deepface).
RUN useradd --create-home --uid 1001 appuser && chown -R appuser:appuser /app
USER appuser

EXPOSE 5000
CMD ["uvicorn", "src.main:app", "--host", "0.0.0.0", "--port", "5000"]
