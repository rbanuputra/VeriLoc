# Copy jadi .env lalu sesuaikan. File .env sudah di-gitignore.

# --- PostgreSQL ---
POSTGRES_USER=geoface
POSTGRES_PASSWORD=geoface123

# --- MinIO (object storage) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123

# --- Auth (core-service) ---
# Generate secret kuat: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=3600s

# --- Seeder Admin awal (dipakai `npm run seed`) ---
ADMIN_EMAIL=admin@geoface.com
ADMIN_PASSWORD=Password123!
